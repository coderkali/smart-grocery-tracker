# Copy this file to .env and fill in your values
# Never commit the .env file to git

# OAuth2 — get these from Google Cloud Console / GitHub Developer Settings
OAUTH2_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH2_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH2_GITHUB_CLIENT_ID=your-github-client-id
OAUTH2_GITHUB_CLIENT_SECRET=your-github-client-secret

# AI
OPENAI_API_KEY=sk-your-openai-key

# Card sync (Plaid sandbox — free)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox


# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_grocery
DB_USER=grocery_user
DB_PASSWORD=grocery_secret