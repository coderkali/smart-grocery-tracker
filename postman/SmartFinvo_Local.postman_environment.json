{
  "id": "env-smartfinvo-local",
  "name": "SmartFinvo - Local",
  "_postman_variable_scope": "environment",
  "values": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "default",
      "enabled": true
    },
    {
      "key": "access_token",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "Paste your JWT access token here after Google OAuth2 login"
    },
    {
      "key": "category_id",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Set this after creating a category"
    },
    {
      "key": "expense_id",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Set this after creating an expense"
    },
    {
      "key": "session_id",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Set this from GET /auth/sessions response"
    },
    {
      "key": "budget_id",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Set this after creating a budget (POST /budgets)"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Target user UUID for admin GET /users/{userId} — must have is_admin=true on your account"
    }
  ]
}
