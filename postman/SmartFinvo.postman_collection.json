{
  "info": {
    "_postman_id": "smartfinvo-collection-v1",
    "name": "SmartFinvo API",
    "description": "Complete API collection for SmartFinvo — Smart Grocery Tracker.\n\n## How to get an Access Token\n\nThis app uses **Google OAuth2** for authentication. There is no username/password login.\n\n**Steps:**\n1. Open a browser and go to: `{{base_url}}/oauth2/authorization/google`\n2. Complete the Google login flow\n3. Copy the `accessToken` from the response JSON\n4. In Postman, go to your environment and paste it into `access_token`\n5. All protected requests will automatically use it via the `Authorization: Bearer {{access_token}}` header\n\n## Typical Test Flow\n1. Get token via Google OAuth2\n2. Call `GET /auth/me` to verify you're logged in\n3. Create a category → copy the `id` into `category_id` variable\n4. Create an expense using that `category_id`\n5. List, update, delete expenses and categories\n6. Try AI features",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "{{base_url}}"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/actuator/health",
              "host": ["{{base_url}}"],
              "path": ["actuator", "health"]
            },
            "description": "Check if the app, database, and Redis are all healthy."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Google OAuth2 Login (Browser Only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/oauth2/authorization/google",
              "host": ["{{base_url}}"],
              "path": ["oauth2", "authorization", "google"]
            },
            "description": "Open this URL in a browser — NOT in Postman. It redirects to Google login. After login, you get back an accessToken. Copy it into the `access_token` environment variable."
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Returns the currently authenticated user's profile. Use this to verify your token works."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "Exchange a refresh token (stored in HttpOnly cookie) for a new access + refresh token pair. Returns a new accessToken."
          }
        },
        {
          "name": "List Active Sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/sessions",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "sessions"]
            },
            "description": "Returns all active login sessions for this user across all devices. Copy a session `id` into the `session_id` variable to revoke it."
          }
        },
        {
          "name": "Revoke Session",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/sessions/{{session_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "sessions", "{{session_id}}"]
            },
            "description": "Revokes one specific session by its UUID. Set `session_id` variable first."
          }
        },
        {
          "name": "Logout (Current Device)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Logs out the current device only. Clears the refresh_token cookie."
          }
        },
        {
          "name": "Logout All Devices",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout/all",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout", "all"]
            },
            "description": "Revokes ALL sessions for this user across every device. Use after a suspected account compromise."
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Groceries\",\n  \"icon\": \"🛒\",\n  \"color\": \"#4CAF50\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/categories",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories"]
            },
            "description": "Creates a new expense category. After creating, copy the `id` from the response into the `category_id` environment variable."
          }
        },
        {
          "name": "List All Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/categories",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories"]
            },
            "description": "Returns all active categories for the authenticated user."
          }
        },
        {
          "name": "Get Category by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/categories/{{category_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories", "{{category_id}}"]
            },
            "description": "Returns a single category by UUID. Set `category_id` variable first."
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Groceries Updated\",\n  \"icon\": \"🛍️\",\n  \"color\": \"#2196F3\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/categories/{{category_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories", "{{category_id}}"]
            },
            "description": "Updates name, icon, and color of an existing category. Set `category_id` variable first."
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/categories/{{category_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories", "{{category_id}}"]
            },
            "description": "Soft-deletes a category (sets is_active = false). Returns 204 No Content."
          }
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "Create Expense",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"{{category_id}}\",\n  \"amount\": 45.99,\n  \"currency\": \"USD\",\n  \"description\": \"Weekly grocery run\",\n  \"expense_date\": \"2026-03-29\",\n  \"payment_method\": \"credit_card\",\n  \"tags\": \"groceries,weekly\",\n  \"notes\": \"Bought from Whole Foods\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/expenses",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "expenses"]
            },
            "description": "Creates a new expense. `category_id` must be a valid category UUID owned by the user. After creating, copy the `id` into the `expense_id` variable."
          }
        },
        {
          "name": "List All Expenses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/expenses",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "expenses"]
            },
            "description": "Returns all expenses for the authenticated user, ordered by expense_date descending."
          }
        },
        {
          "name": "Get Expense by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/expenses/{{expense_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "expenses", "{{expense_id}}"]
            },
            "description": "Returns a single expense by UUID. Set `expense_id` variable first."
          }
        },
        {
          "name": "Filter Expenses by Date Range",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/expenses?start_date=2026-01-01&end_date=2026-03-31",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "expenses"],
              "query": [
                {
                  "key": "start_date",
                  "value": "2026-01-01",
                  "description": "Start date inclusive (YYYY-MM-DD)"
                },
                {
                  "key": "end_date",
                  "value": "2026-03-31",
                  "description": "End date inclusive (YYYY-MM-DD)"
                }
              ]
            },
            "description": "Returns expenses whose expense_date falls within the given range. Both dates are inclusive."
          }
        },
        {
          "name": "Filter Expenses by Category",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/expenses?category_id={{category_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "expenses"],
              "query": [
                {
                  "key": "category_id",
                  "value": "{{category_id}}",
                  "description": "UUID of the category to filter by"
                }
              ]
            },
            "description": "Returns all expenses belonging to a specific category. Set `category_id` variable first."
          }
        },
        {
          "name": "Update Expense",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"{{category_id}}\",\n  \"amount\": 52.50,\n  \"description\": \"Weekly grocery run — updated\",\n  \"expense_date\": \"2026-03-29\",\n  \"payment_method\": \"debit_card\",\n  \"tags\": \"groceries,weekly,updated\",\n  \"notes\": \"Price correction\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/expenses/{{expense_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "expenses", "{{expense_id}}"]
            },
            "description": "Updates an existing expense. Set `expense_id` variable first."
          }
        },
        {
          "name": "Delete Expense",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/expenses/{{expense_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "expenses", "{{expense_id}}"]
            },
            "description": "Soft-deletes an expense. Returns 204 No Content."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Returns the full profile of the authenticated user (id, email, display_name, avatar_url, status, onboarding_step, version, timestamps)."
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"Jane Doe\",\n  \"first_name\": \"Jane\",\n  \"last_name\": \"Doe\",\n  \"avatar_url\": \"https://storage.example.com/avatars/jane.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Partially updates the authenticated user's profile. All fields are optional — only provided fields are changed. Returns the full updated profile."
          }
        },
        {
          "name": "Get User by ID (Admin Only)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{user_id}}"]
            },
            "description": "Admin-only: fetches any user's profile by UUID. Requires is_admin = true on the calling user's account. Set `user_id` variable to the target user's UUID. Returns 403 for non-admin callers."
          }
        },
        {
          "name": "Delete My Account",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirmDeletion\": true,\n  \"reason\": \"No longer needed\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Soft-deletes the authenticated user's account and revokes ALL active sessions. `confirmDeletion` must be true — sending false or omitting it returns 400. Returns 204 No Content. Discard your JWT immediately after this call."
          }
        }
      ]
    },
    {
      "name": "Budgets",
      "item": [
        {
          "name": "Create Budget",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Monthly Groceries\",\n  \"category_id\": \"{{category_id}}\",\n  \"limit_amount\": 300.00,\n  \"currency\": \"USD\",\n  \"period\": \"MONTHLY\",\n  \"start_date\": \"2026-04-01\",\n  \"alert_threshold\": 80,\n  \"alert_enabled\": true,\n  \"alert_channels\": [\"email\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/budgets",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "budgets"]
            },
            "description": "Creates a new spending budget for a category. `end_date` is optional — if omitted it is inferred from `period` (MONTHLY adds 1 month, QUARTERLY adds 3, YEARLY adds 12). After creating, copy the `id` into the `budget_id` variable. `current_spent` will be 0 on creation."
          }
        },
        {
          "name": "List All Budgets",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/budgets",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "budgets"]
            },
            "description": "Returns all active budgets for the user, ordered by creation date descending. Each budget includes live `current_spent`, `remaining_amount`, `percentage_used`, and `alert_status` calculated from matching expense records."
          }
        },
        {
          "name": "Get Budget by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/budgets/{{budget_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "budgets", "{{budget_id}}"]
            },
            "description": "Returns a single budget with real-time spending figures. `alert_status` is OK, WARNING (>= threshold), or EXCEEDED (>= 100%). Set `budget_id` variable first."
          }
        },
        {
          "name": "Update Budget",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit_amount\": 350.00,\n  \"alert_threshold\": 75,\n  \"alert_enabled\": true,\n  \"alert_channels\": [\"email\", \"push\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/budgets/{{budget_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "budgets", "{{budget_id}}"]
            },
            "description": "Partially updates a budget. Only `name`, `limit_amount`, `alert_threshold`, `alert_enabled`, `alert_channels` can be changed. Category and dates are fixed after creation. Set `budget_id` variable first."
          }
        },
        {
          "name": "Delete Budget",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/budgets/{{budget_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "budgets", "{{budget_id}}"]
            },
            "description": "Soft-deletes a budget. Existing expenses are not affected. Returns 204 No Content. Set `budget_id` variable first."
          }
        }
      ]
    },
    {
      "name": "Expenses (Bulk)",
      "item": [
        {
          "name": "Bulk Create Expenses",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receipt_date\": \"2026-04-05\",\n  \"vendor\": \"Whole Foods Market\",\n  \"receipt_image_url\": \"https://storage.example.com/receipts/wf-20260405.jpg\",\n  \"items\": [\n    {\n      \"category_id\": \"{{category_id}}\",\n      \"amount\": 12.49,\n      \"description\": \"Organic whole milk 2L\",\n      \"currency\": \"USD\"\n    },\n    {\n      \"category_id\": \"{{category_id}}\",\n      \"amount\": 5.99,\n      \"description\": \"Free range eggs x12\",\n      \"currency\": \"USD\"\n    },\n    {\n      \"category_id\": \"{{category_id}}\",\n      \"amount\": 3.49,\n      \"description\": \"Sourdough bread loaf\",\n      \"currency\": \"USD\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/expenses/bulk",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "expenses", "bulk"]
            },
            "description": "Creates up to 100 expense records in one transaction. All items share `receipt_date`, `vendor`, and `receipt_image_url`. If any item fails, the entire batch is rolled back. Returns `created_count` and the full list of created expense records."
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Expense Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/analytics/summary?start_date=2026-04-01&end_date=2026-04-30",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "analytics", "summary"],
              "query": [
                { "key": "start_date", "value": "2026-04-01", "description": "Start date inclusive (YYYY-MM-DD)" },
                { "key": "end_date",   "value": "2026-04-30", "description": "End date inclusive (YYYY-MM-DD)" }
              ]
            },
            "description": "Returns total spending, count, average per expense, and a breakdown by category for the given date range. The `by_category` map is keyed by category UUID."
          }
        },
        {
          "name": "Spending Trends (Daily)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/analytics/trends?start_date=2026-04-01&end_date=2026-04-30&group_by=day",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "analytics", "trends"],
              "query": [
