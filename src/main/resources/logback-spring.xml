<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ── Console appender ─────────────────────────────────────────────── -->
    <!-- In production this would ship to Datadog / ELK / CloudWatch        -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- LogstashEncoder outputs structured JSON                     -->
            <!-- Every log line is a JSON object — easy to search and filter -->
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>provider</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- ── Auth module — DEBUG in dev, INFO in prod ─────────────────────── -->
    <springProfile name="default,local,dev">
    <logger name="com.smartgrocery.modules.auth" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.springframework.security" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="io.r2dbc" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
    </springProfile>

    <springProfile name="prod">
        <logger name="com.smartgrocery.modules.auth" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.springframework.security" level="WARN" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
    </springProfile>

    <!-- ── Root logger ───────────────────────────────────────────────────── -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>